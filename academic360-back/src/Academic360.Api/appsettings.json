{
  "ConnectionStrings": {
    "DefaultConnection": "",
    "RedisConnection": "localhost:6379"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "Academic360Api",
    "Audience": "Academic360Front"
  }
}